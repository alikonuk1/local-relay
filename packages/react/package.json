{
  "name": "@local-relay/react",
  "version": "0.1.0",
  "description": "React hooks and lightweight UI primitives for Local Relay.",
  "type": "module",
  "license": "MIT",
  "author": "alikonuk1 <alikonuk1@protonmail.com>",
  "homepage": "https://github.com/alikonuk1/local-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alikonuk1/local-relay.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/alikonuk1/local-relay/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "local-ai",
    "llm",
    "ollama",
    "lm-studio",
    "openai-compatible",
    "react"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build -w @local-relay/core && tsc -p tsconfig.json",
    "typecheck": "npm run build -w @local-relay/core && tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@local-relay/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18"
  }
}
